{
  "format": "atunbi.architecture.v1",
  "purpose": "Matrix engine → modular workspace → applications",
  "ratings": "Design judgments by signal function; not empirical causal effects",
  "subsystemDesign": [
    {
      "group": "Engine",
      "role": "S1 · operations",
      "purpose": "Execute declared algorithms while preserving the binary kernel boundary.",
      "parts": "G8: 1,000-bit state, instruction compiler, VM, messages and clock. G7: sentence compiler and VM. G6: environments, internal layers, numeric fields and signed edges. G10: PID registers, drivers and binary plant. G11: algorithm catalogue, node state, parameters and synchronous coupling.",
      "contract": "Declared configuration and inputs → next state, binary output and evidence. Numerical registers belong to the relevant algorithm adapter, not implicit meaning in the binary cells.",
      "verification": "Binary bounds; deterministic replay; prior-state immutability; full-state export/import continuation."
    },
    {
      "group": "Workspace",
      "role": "S1 operations / S2 coordination",
      "purpose": "Compose processes above the engine; keep definitions separate from running instances.",
      "parts": "Rule workshop: identity, truth table, validation, saved definitions. Registry: versioned definitions and installation. Flow runtime: typed ports, edge validation, queues, delay ticks and trace. Wiring editor: connect, disconnect and save. General blank canvas and reusable composite modules: proposed.",
      "contract": "Definitions + graph + commands → validated instances and routed messages. A process has inputs, state, algorithm and outputs.",
      "verification": "Reject incompatible ports and immediate cycles; bound messages; preserve explicit delays; reject invalid imports atomically."
    },
    {
      "group": "Observation",
      "role": "S3* · audit / S4 · investigation",
      "purpose": "Make behavior inspectable and compare explanations against controlled evidence.",
      "parts": "G9: descriptors, exact recurrence, matched interventions and annotation status. Metrics: snapshots and displays. Notebook: observer hypotheses. Exports: configurations and evidence. Experiment tools: edge ablations, baselines and replay.",
      "contract": "State and run configuration → observations, comparisons and provenance. A descriptor is not proof of emergence.",
      "verification": "Known fixtures; matched initial states; non-mutating comparisons; explicit hypothesis status and reproducible exports."
    },
    {
      "group": "Governance",
      "role": "S3 control / S4 adaptation / S5 identity",
      "purpose": "Manage technical decisions, verification, risk and changes while retaining the engine purpose.",
      "parts": "Foundation: purpose and research. Feature inventory: responsibilities and connections. References: external knowledge. Tests and CI: verification. Git history: configuration baseline. Deployment service: release boundary. Automated resource policy, compatibility migration and runtime health supervisor: proposed.",
      "contract": "Needs and evidence → requirements, architecture decisions, acceptance checks and reviewed releases. People retain policy authority.",
      "verification": "Requirement-to-test traceability; versioned baselines; release checks; rollback source. VSM is a design analogy, not a claim of autonomous viability."
    },
    {
      "group": "Interface",
      "role": "S2 coordination / human interface",
      "purpose": "Expose processes without changing what the engine means.",
      "parts": "Navigation and home: page organization. Module views: controls and state display. Controllers: categorized actions and guards. Spatial viewer: camera, 3D volume, WebXR and desktop fallback. Logo and shell: identity.",
      "contract": "User intent → validated command; model snapshot → accessible view. A webpage is an interface, not necessarily a separate processor.",
      "verification": "Keyboard and screen-reader checks; routing/history; controller guards; simulated XR. Physical headset validation remains separate."
    }
  ],
  "dynamicsDesign": [
    {
      "stock": "Matrix and algorithm state",
      "inflow": "Declared transition / incoming signal",
      "outflow": "Reset or replacement",
      "feedback": "Output → measurement → controller → next input",
      "status": "Implemented in specific engines; signs and gains are configuration dependent."
    },
    {
      "stock": "Pending messages",
      "inflow": "Emission onto delayed edges",
      "outflow": "Explicit workflow advance; disabling an edge removes pending messages",
      "feedback": "Queue growth → proposed resource supervisor → producer throttling",
      "status": "Bounded queues and explicit advance implemented; adaptive throttling proposed."
    },
    {
      "stock": "Saved algorithm definitions",
      "inflow": "Validated rule creation or import",
      "outflow": "Removal or replacement under registry rules",
      "feedback": "Test result → revise definition → test again",
      "status": "Human-guided iteration; no autonomous algorithm improvement claimed."
    },
    {
      "stock": "Evidence and observer records",
      "inflow": "Measurements, experiments, annotations",
      "outflow": "User deletion or external archival",
      "feedback": "Comparison → hypothesis revision → new experiment",
      "status": "Human interpretation; no claim that accumulating records automatically increases knowledge."
    }
  ],
